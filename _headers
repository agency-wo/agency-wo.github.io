# WHO SERVES THIS. GitHub Pages ignores this file entirely, and always has.
# The line below is the source of truth for the four headers, and Cloudflare is
# what puts them on the wire: the record is proxied and a Modify Response
# Header rule carries these values. Change them here first, then paste, so the
# repo and the edge cannot drift apart with nobody able to say which is right.
#
# THE 120 sha256 HASHES ARE GONE. Every one of them covered a
# <script type="application/ld+json"> block, and CSP Level 3 is explicit that a
# script whose type is not a JavaScript MIME type is a data block and is not
# subject to script-src. Tested rather than believed: this page served under
# exactly the policy below, with no hashes at all, logs zero violations, the
# ld+json parses, and main.js runs. The policy went from 6,726 characters to
# 246, which is also what let it fit in a response-header rule.
#
# The only executable script on any page is /js/main.js, loaded by src and
# already covered by 'self'. Gate check 4 fails the build if a page ever grows
# an inline one, which is the guarantee the hashes used to give by accident.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.web3forms.com; object-src 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com; frame-ancestors 'self'

# Cache lifetimes. On Cloudflare these are set as Cache Rules in the dashboard
# rather than read from here; the values are kept in one place so the rule and
# the repo agree. HTML is deliberately absent: it stays short so a deploy is
# visible immediately.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/logo/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# 30 days and NOT immutable, unlike the fonts and logos above: those change
# by being renamed or never, while a proof chart is a Search Console
# screenshot that gets re-taken under the same filename when the numbers
# move, and a plate is re-shot when a client redesigns. A year of immutable
# would pin last quarter's chart in every returning visitor's cache.
/assets/plates/*
  Cache-Control: public, max-age=2592000

/assets/proof/*
  Cache-Control: public, max-age=2592000
